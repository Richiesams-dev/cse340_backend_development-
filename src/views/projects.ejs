<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Upcoming Service Projects</h2>
        <p>Here are the service projects our partner organizations are sponsoring:</p>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <strong>
                        <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long'
                            , day: 'numeric' }) %>
                    </strong>:
                    <%= project.title %> (<%= project.organization_name %>)
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>